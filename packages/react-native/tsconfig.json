{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "skipLibCheck": true,
    "paths": {
      "@sagegames/types": [
        "packages/types/src/index.ts"
      ],
      "@sagegames/core": [
        "packages/core/src/index.ts"
      ],
      "@sagegames/react": [
        "packages/react/src/index.ts"
      ],
      "@sagegames/react-native": [
        "packages/react-native/src/index.ts"
      ],
      "@sagegames/game-quiz-master": [
        "games/quiz-master/src/index.ts"
      ],
      "@sagegames/game-word-rush": [
        "games/word-rush/src/index.ts"
      ],
      "@sagegames/game-memory-match": [
        "games/memory-match/src/index.ts"
      ],
      "@sagegames/game-word-search": [
        "games/word-search/src/index.ts"
      ],
      "@sagegames/game-sudoku": [
        "games/sudoku/src/index.ts"
      ],
      "@sagegames/engine": [
        "packages/engine/src/index.ts"
      ],
      "react-native": [
        "node_modules/react-native/types_generated/index.d.ts"
      ],
      "@sagegames/react-headless": [
        "packages/react-headless/src/index.ts"
      ]
    },
    "target": "ES2019"
  },
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../core"
    },
    {
      "path": "../react-headless"
    },
    {
      "path": "../../games/memory-match"
    },
    {
      "path": "../../games/quiz-master"
    },
    {
      "path": "../../games/sudoku"
    },
    {
      "path": "../../games/word-rush"
    },
    {
      "path": "../../games/word-search"
    }
  ],
  "include": [
    "src/**/*"
  ]
}
