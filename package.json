{
  "name": "sage-game-platform-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "SageGame - Type-safe Multi-Tenant Multi-Game Game-as-a-Service (GaaS) Platform Monorepo",
  "workspaces": [
    "packages/*",
    "games/*",
    "services/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc --build && npm run build -w services/portal",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:dictionary": "node games/word-rush/scripts/build-dictionary.js",
    "build:packages": "tsc --build",
    "db:push": "supabase db push",
    "db:new": "supabase migration new",
    "playground": "vite --config tools/playground/vite.config.ts",
    "test:ui": "node tools/playground/play.mjs .ui-shots/native && node tools/playground/play.mjs .ui-shots/web sdk=web",
    "battle-server": "node tools/playground/battle-server.mjs",
    "test:battle": "node tools/playground/battle.mjs .ui-shots/battle && node tools/playground/battle.mjs .ui-shots/battle-web sdk=web",
    "typecheck:examples": "tsc -p tools/playground/tsconfig.examples.json",
    "docs:check": "node tools/docs/check-docs.mjs",
    "test:portal": "node tools/portal-preview/shoot.mjs .ui-shots/portal"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react-native": "^0.73.0",
    "an-array-of-english-words": "^2.0.0",
    "fast-check": "^4.10.2",
    "playwright": "^1.63.0",
    "react-native-web": "^0.21.2",
    "supabase": "^2.117.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
