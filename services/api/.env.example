# Copy to services/api/.env for local runs (never commit the real file). Every setting is also
# described in docs/DEPLOYMENT.md.

NODE_ENV=development
PORT=4000

# Any supported database:
#   sqlite:./data/sagegames.db                         (one file; nothing else to run)
#   postgres://user:password@host:5432/sagegames       (Railway, Neon, RDS, self-hosted…)
#   mysql://user:password@host:3306/sagegames          (MySQL 8 / MariaDB 10.6+)
DATABASE_URL=sqlite:./data/sagegames.db
# auto (TLS for public hosts) | true | false
# DATABASE_SSL=auto
# Connections to keep open (Postgres/MySQL); lower it on small plans.
# DATABASE_POOL_SIZE=10

# 32+ random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_KEY_PEPPER: changing it invalidates every API key ever issued.
API_KEY_PEPPER=
# AUTH_JWT_SECRET: signs portal sessions; changing it signs everyone out of the portal.
AUTH_JWT_SECRET=

# Where this API is reachable (the portal is served at /portal; email links point here).
PUBLIC_BASE_URL=http://localhost:4000

# Account emails (sign-up confirmation, password reset) through Brevo. Without a key, development
# logs the links instead of sending them.
# BREVO_API_KEY=
# EMAIL_FROM=SageGames <no-reply@example.com>

# Optional bootstrap keys for apps that existed before the portal ("tenant_id:secret,...").
# SAGE_TENANT_KEYS=

# Optional: report unexpected errors to Sentry (leave empty to only log them)
SENTRY_DSN=
# Optional: debug | info | warn | error | silent (default info)
LOG_LEVEL=info
# Optional: pretty (default locally) | json (default in production)
# LOG_FORMAT=pretty
# Optional: the deployed version in logs and Sentry (defaults to the host's commit variable)
# RELEASE=
