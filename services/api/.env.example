# Copy to services/api/.env for local runs (never commit the real file).

NODE_ENV=development
PORT=4000

# Supabase > Project Settings > Database > Connection string > "Session pooler" (port 5432).
# Do not use the transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable/anon key>
# Only for projects still on the legacy HS256 JWT secret; leave unset to use the project's JWKS.
# SUPABASE_JWT_SECRET=

# 32+ random characters. Changing it invalidates every API key ever issued.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PEPPER=

# Where this API is reachable (the portal is served at /portal).
PUBLIC_BASE_URL=http://localhost:4000

# Optional bootstrap keys for tenants that existed before the portal ("tenant_id:secret,...").
# SAGE_TENANT_KEYS=

# Optional: report unexpected errors to Sentry (leave empty to only log them)
SENTRY_DSN=
# Optional: debug | info | warn | error | silent (default info)
LOG_LEVEL=info
# Optional: pretty (default locally) | json (default in production)
# LOG_FORMAT=pretty
