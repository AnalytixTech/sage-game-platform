# SageGames production configuration for Docker Compose (compose.yml).
#   cp .env.example .env && chmod 600 .env     # then fill in the values; never commit .env
#
# Generate secrets with:
#   openssl rand -hex 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#
# Local development without Docker uses services/api/.env.example instead.

# =============================================================================================
# BUILD-TIME (docker compose build) — optional
# =============================================================================================
# Image name and tag to build and run (set a version tag to make rollbacks a one-line change).
SAGEGAMES_IMAGE=sagegames:latest
# The Node.js version is a build argument in the Dockerfile (NODE_VERSION, default 22.20.0).
# Nothing else is needed at build time: no secrets or URLs are baked into the image.

# =============================================================================================
# COMPOSE / HOST — how this product sits on the shared VPS
# =============================================================================================
# Prefix for this product's containers, networks and volumes (keep it unique per product).
COMPOSE_PROJECT_NAME=sagegames
# The shared reverse-proxy network (create once per VPS: docker network create proxy).
PROXY_NETWORK=proxy
# Uncomment to run the bundled Postgres (see DATABASE_URL below).
# COMPOSE_PROFILES=postgres
# Resource limits (see docs/DOCKER.md#resource-management).
SAGEGAMES_CPUS=1.0
SAGEGAMES_MEMORY=512M
SAGEGAMES_HEAP_MB=384
# SAGEGAMES_DB_CPUS=1.0
# SAGEGAMES_DB_MEMORY=512M

# =============================================================================================
# RUNTIME — read by the app when the container starts
# =============================================================================================

# ---- Required ---------------------------------------------------------------------------------

# The database. One of:
#   sqlite:/app/data/sagegames.db                                   (file on the sagegames-data volume)
#   postgres://sagegames:<POSTGRES_PASSWORD>@sagegames-db:5432/sagegames   (bundled Postgres profile)
#   postgres://user:password@host:5432/dbname                       (managed / external Postgres)
#   mysql://user:password@host:3306/dbname                          (MySQL 8 / MariaDB 10.6+)
DATABASE_URL=sqlite:/app/data/sagegames.db

# Mixed into API key hashes. 32+ characters. CHANGING IT INVALIDATES EVERY API KEY: back it up.
API_KEY_PEPPER=change-me-to-64-hex-characters-from-openssl-rand-hex-32
# Signs developer-portal sessions. 32+ characters. Changing it signs everyone out of the portal.
AUTH_JWT_SECRET=change-me-to-a-different-64-hex-character-secret
# The public https address (the portal is at /portal; email links point here).
PUBLIC_BASE_URL=https://games.example.com

# ---- Required for portal sign-up and password reset emails ------------------------------------
# Brevo transactional email API key (xkeysib-…) and the authenticated sender.
BREVO_API_KEY=
EMAIL_FROM=SageGames <no-reply@example.com>

# ---- Optional ---------------------------------------------------------------------------------
# TLS to the database: auto (on for public hostnames, off for Docker service names) | true | false
DATABASE_SSL=auto
# Database connections to keep open (Postgres/MySQL).
DATABASE_POOL_SIZE=10
# Bootstrap keys for apps that existed before the portal: "tenant_id:secret,…"
SAGE_TENANT_KEYS=
# Report unexpected errors to Sentry.
SENTRY_DSN=
# debug | info | warn | error | silent
LOG_LEVEL=info
# json (default in production) | pretty
LOG_FORMAT=json
# Version shown in logs and Sentry (e.g. the git commit being deployed).
RELEASE=

# ---- Bundled Postgres (only with COMPOSE_PROFILES=postgres) -----------------------------------
POSTGRES_DB=sagegames
POSTGRES_USER=sagegames
POSTGRES_PASSWORD=
